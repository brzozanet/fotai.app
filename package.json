{
  "name": "fotai.app",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "dependencies": {
    "npm-run-all": "^4.1.5"
  },
  "scripts": {
    "frontend": "npm run dev --workspace=frontend",
    "backend": "npm run dev --workspace=backend",
    "dev": "npm-run-all --parallel frontend backend"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.1": true,
    "prisma@7.8.0": true,
    "@prisma/engines@7.8.0": true
  }
}
